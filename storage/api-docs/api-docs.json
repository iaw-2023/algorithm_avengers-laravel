                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error inesperado"
                    }
                }
            }
        },
        "/rest/clientes/perfil": {
            "get": {
                "tags": [
                    "clientes"
                ],
                "summary": "Devuelve el perfil del cliente",
                "description": "Devuelve los datos del cliente actual",
                "operationId": "1d913b4c62903d3d11d7448274426fe3",
                "responses": {
                    "200": {
                        "description": "Operación realizada con éxito",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Cliente"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error inesperado"
                    }
                }
            }
        },
        "/rest/clientes/registrar": {
            "post": {
                "tags": [
                    "clientes"
                ],
                "summary": "Registra un nuevo cliente en el sistema",
                "description": "Registra un nuevo cliente en el sistema y retorna su Token Bearer de autorización",
                "operationId": "9a519cd44994ccb7070233b492daec2e",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "contrasena": {
                                        "description": "Contraseña codificada en md5",
                                        "type": "string"
                                    },
                                    "nombre": {
                                        "type": "string"
                                    },
                                    "telefono": {
                                        "type": "string"
                                    },
                                    "domicilio": {
                                        "type": "string"
                                    }
                                },
                                "type": "object",
                                "example": {
                                    "email": "juan_gonzález@example.com",
                                    "contrasena": "12345",
                                    "nombre": "Juan González",
                                    "telefono": "+54 1 111 111 1111",
                                    "domicilio": "San Martín 1810"
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Operación realizada con éxito",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenBearer"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error inesperado"
                    }
                }
            }
        },
        "/rest/clientes/login": {
            "post": {
                "tags": [
                    "clientes"
                ],
                "summary": "Inicia sesión de un cliente",
                "description": "Inicia sesión de un cliente previamente registrado y retorna su Token Bearer",
                "operationId": "4615fc020af6c2cd945ca25d74cb2c4f",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "contrasena": {
                                        "description": "Contraseña codificada en md5",
                                        "type": "string"
                                    }
                                },
                                "type": "object",
                                "example": {
                                    "email": "test@mail.com",
                                    "contrasena": "12345"
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Operación realizada con éxito",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenBearer"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "ID no encontrado. Probablemente se haya ingresado un ID no válido."
                    },
                    "default": {
                        "description": "Error inesperado"
                    }
                }
            }
        },
        "/rest/clientes/logout": {
            "post": {
                "tags": [
                    "clientes"
                ],
                "summary": "Cierra sesión de un cliente",
                "description": "Cierra sesión de un cliente con su sesión previamente iniciada",
                "operationId": "abf647ba920165d8d41802227b971bf3",
                "responses": {
                    "200": {
                        "description": "Operación realizada con éxito",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenBearer"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "ID no encontrado. Probablemente se haya ingresado un ID no válido."
