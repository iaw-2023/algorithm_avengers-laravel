    "components": {
        "schemas": {
            "TokenBearer": {
                "properties": {
                    "token": {
                        "description": "Token Bearer de autenticación",
                        "type": "string",
                        "example": "146|UvgdE5fWpMoRTyTT8IpzSANxLS86wwqztYf2srx8b9217403"
                    }
                },
                "type": "object"
            },
            "Categoria": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 3
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Masculinidades"
                    },
                    "descripcion": {
                        "type": "string",
                        "example": "Ropa diseñada para masculinidades"
                    }
                },
                "type": "object"
            },
            "Cliente": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 2
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "juan_gonzález@example.com"
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Juan González"
                    },
                    "telefono": {
                        "type": "string",
                        "example": "+54 1 111 111 1111"
                    },
                    "domicilio": {
                        "type": "string",
                        "example": "San Martín 1810"
                    }
                },
                "type": "object"
            },
            "Compra": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "precio": {
                        "type": "number",
                        "example": 12345.67
                    },
                    "fecha": {
                        "type": "string",
                        "format": "date"
                    },
                    "email_cliente": {
                        "type": "string",
                        "example": "jose_sanmartin@example.com"
                    },
                    "detalle_orden": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DetalleOrden"
                        }
                    }
                },
                "type": "object"
            },
            "CompraPost": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "precio": {
                        "type": "number",
                        "example": 12345.67
                    },
                    "fecha": {
                        "type": "string",
                        "format": "date"
                    },
                    "email_cliente": {
                        "type": "string",
                        "example": "jose_sanmartin@example.com"
                    }
                },
                "type": "object"
            },
            "DetalleOrden": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 4
                    },
                    "producto_id": {
                        "$ref": "#/components/schemas/Producto/properties/id"
                    },
                    "talle": {
                        "description": "Talles válidos: 'XS','S','M','L','XL','XXL','XXXL','XXXXL','XXXXXL'",
                        "type": "string",
                        "example": "XL"
                    },
                    "cantidad": {
                        "type": "integer",
                        "example": 2
                    },
                    "nombre_producto": {
                        "$ref": "#/components/schemas/Producto/properties/nombre"
                    }
                },
                "type": "object"
            },
            "Producto": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Buzo Rebelde"
                    },
                    "descripcion": {
                        "type": "string",
                        "example": "Buzo estampado en la espalda"
                    },
                    "imagen": {
                        "type": "string",
                        "example": "www.sitio.com/imagen.jpg"
                    },
                    "imagen_public_id": {
                        "type": "string",
                        "example": "folder/zpafbqomzvhrlzrrzezq"
                    },
                    "precio": {
                        "type": "number",
                        "example": 1234.56
                    },
                    "talles": {
                        "type": "string",
                        "example": "XS,S,M,L,XL,XXL,XXXL,XXXXL,XXXXXL"
                    },
                    "categoria": {
                        "properties": {
                            "id": {
                                "$ref": "#/components/schemas/Categoria/properties/id"
                            },
                            "nombre": {
                                "$ref": "#/components/schemas/Categoria/properties/nombre"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "ProductoByCategoria": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Buzo Rebelde"
                    },
                    "descripcion": {
                        "type": "string",
                        "example": "Buzo estampado en la espalda"
                    },
                    "precio": {
                        "type": "number",
                        "example": 1234.56
                    },
                    "imagen": {
                        "type": "string",
                        "example": "www.sitio.com/imagen.jpg"
                    },
                    "talles": {
                        "type": "string",
                        "example": "XS,S,M,L,XL,XXL,XXXL,XXXXL,XXXXXL"
                    }
                },
                "type": "object"
            }
        },
        "responses": {
            "default": {
                "description": "Error inesperado"
            }
        }
    },
